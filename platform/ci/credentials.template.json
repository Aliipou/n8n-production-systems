[
  {
    "id": "ci-mock-llm-openai",
    "name": "CI mock-llm OpenAI",
    "type": "openAiApi",
    "data": {
      "apiKey": "${MOCK_LLM_API_KEY}",
      "url": "${MOCK_LLM_URL}",
      "header": false
    }
  },
  {
    "id": "ci-header-auth",
    "name": "CI Header Auth",
    "type": "httpHeaderAuth",
    "data": {
      "name": "X-Internal-Token",
      "value": "${INTERNAL_API_TOKEN}"
    }
  },
  {
    "id": "ci-postgres-app",
    "name": "CI app Postgres",
    "type": "postgres",
    "data": {
      "host": "${POSTGRES_HOST}",
      "database": "${POSTGRES_DB_APP}",
      "user": "${POSTGRES_USER}",
      "password": "${POSTGRES_PASSWORD}",
      "port": "${POSTGRES_PORT}",
      "ssl": "disable",
      "maxConnections": 20,
      "allowUnauthorizedCerts": false
    }
  }
]
