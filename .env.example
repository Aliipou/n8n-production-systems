# Copy to .env for local use. Never commit .env.
# Placeholder values only. Generate real secrets locally.
#
# n8n environment variable names used by compose will be confirmed in
# PLT-T02 / PLT-T03 against the official docs of the pinned n8n 2.x version.
# Do not treat names below as a complete n8n config.

POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB_N8N=n8n
POSTGRES_DB_APP=app

REDIS_PASSWORD=change-me

N8N_ENCRYPTION_KEY=change-me
N8N_API_KEY=

TZ=Europe/Helsinki
GENERIC_TIMEZONE=Europe/Helsinki

# Internal token used by n8n Header Auth to call project backends (later phases).
INTERNAL_API_TOKEN=change-me
