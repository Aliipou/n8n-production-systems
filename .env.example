# Copy to .env for local use. Never commit .env.
# Replace every change-me value before `make up`.

POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB_N8N=n8n
POSTGRES_DB_APP=app

REDIS_PASSWORD=change-me

# Identical on n8n-main and both workers. n8n encrypts credentials with this key.
# Generate a long random string locally. Do not reuse the placeholder.
N8N_ENCRYPTION_KEY=change-me-generate-a-long-random-string

# Set after the one-time owner account and API key in the local editor.
N8N_API_KEY=

TZ=Europe/Helsinki
GENERIC_TIMEZONE=Europe/Helsinki

# Internal token for later project backends. Not for Code nodes.
INTERNAL_API_TOKEN=change-me
