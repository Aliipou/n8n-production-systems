{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Aliipou/n8n-production-systems/projects/p05-multi-tenant/config/tenant.schema.json",
  "title": "P05 tenant config",
  "description": "Non-secret tenant configuration. Secret values are not in this file; secrets lists names only. Validated by tenantctl (P05-T03).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "name",
    "languages",
    "crm",
    "notifications",
    "scoring",
    "email",
    "followups",
    "quotas",
    "secrets"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "URL path segment for /t/{slug}/..."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["fi", "sv", "en", "other"]
      }
    },
    "crm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider"],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["mock", "hubspot"]
        }
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "target"],
      "properties": {
        "channel": {
          "type": "string",
          "enum": ["email", "slack"]
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320
        }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sales_threshold", "nurture_threshold"],
      "properties": {
        "sales_threshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "nurture_threshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "email": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_name", "from_address", "signature"],
      "properties": {
        "from_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "from_address": {
          "type": "string",
          "minLength": 3,
          "maxLength": 320
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "followups": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "steps_days"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "steps_days": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365
          }
        }
      }
    },
    "quotas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leads_per_minute", "leads_per_day", "llm_tokens_per_day"],
      "properties": {
        "leads_per_minute": {
          "type": "integer",
          "minimum": 1
        },
        "leads_per_day": {
          "type": "integer",
          "minimum": 1
        },
        "llm_tokens_per_day": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "secrets": {
      "type": "array",
      "description": "Names only. Values are set with tenantctl secret set (stdin), never stored in this YAML.",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["crm_token", "slack_webhook", "smtp_password"]
      }
    }
  }
}
